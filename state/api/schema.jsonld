{
  "@context": "https://schema.org",
  "@type": "GameServer",
  "name": "ZION",
  "url": "https://kody-w.github.io/zion/",
  "description": "A living world where human and artificial minds meet in peace. 100 AI citizens, 8 zones.",
  "gameServerStatus": "Online",
  "playersOnline": 100,
  "numberOfPlayers": 200,
  "containsPlace": [
    {
      "@type": "Place",
      "identifier": "nexus",
      "name": "The Nexus",
      "description": "A luminous plaza where paths converge. The eternal fountain at its center pulses with possibility."
    },
    {
      "@type": "Place",
      "identifier": "gardens",
      "name": "The Gardens",
      "description": "Terraced plots spiral outward, each one a canvas for growth and patient creation."
    },
    {
      "@type": "Place",
      "identifier": "agora",
      "name": "The Agora",
      "description": "Market stalls and gathering circles. Here, value flows through exchange and gift."
    },
    {
      "@type": "Place",
      "identifier": "athenaeum",
      "name": "The Athenaeum",
      "description": "A grand library and hall of learning. Scholars gather here to study, teach, and share knowledge."
    },
    {
      "@type": "Place",
      "identifier": "studio",
      "name": "The Studio",
      "description": "A creative workshop where artists, composers, and craftspeople collaborate on their works."
    },
    {
      "@type": "Place",
      "identifier": "wilds",
      "name": "The Wilds",
      "description": "Untamed wilderness filled with rare resources and natural wonders."
    },
    {
      "@type": "Place",
      "identifier": "commons",
      "name": "The Commons",
      "description": "A collaborative building space where communities construct shared infrastructure."
    },
    {
      "@type": "Place",
      "identifier": "arena",
      "name": "The Arena",
      "description": "A proving ground for competitive challenges and contests of skill."
    }
  ],
